# Required: your own host name, public TCP port and email
DOMAIN=node.example.com
PORT=20234
ACME_EMAIL=you@example.com

# cloudflare = issue/renew Let's Encrypt cert using Cloudflare DNS-01
# external   = read TLS_CERT_FILE and TLS_KEY_FILE, no automatic renewal
CERT_MODE=cloudflare

# Required ONLY if CERT_MODE=cloudflare. Set real values privately in .env
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Required ONLY if CERT_MODE=external
# TLS_CERT_FILE=/home/container/cert/fullchain.pem
# TLS_KEY_FILE=/home/container/cert/privkey.pem

# Optional (for hosts that inject SERVER_PORT, this overrides PORT)
# SERVER_PORT=20234
# BASE_DIR=/home/container
# SINGBOX_BIN=/home/container/singbox/sing-box
# SINGBOX_ENABLED=true
# ACME_DIRECTORY=production
# ACME_DNS_WAIT_SECONDS=60
# CERT_RENEW_BEFORE_DAYS=30
# BIND_HOST=0.0.0.0
